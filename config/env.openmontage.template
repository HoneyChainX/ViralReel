# OpenMontage — production. Copied to vendor/openmontage/.env by make setup.
#
# Every key left empty below is a COST CONTROL, not an oversight. OpenMontage
# scores and selects providers automatically; it cannot bill what it cannot see.
# scripts/doctor.sh FAILS if any of the paid keys get set.

# --- the only paid service, and you already pay for it ---
ELEVENLABS_API_KEY=

# --- free tiers ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- local, no cost ---
VIDEO_GEN_LOCAL_ENABLED=false

# --- DELIBERATELY EMPTY: paid generators ---
# Generated b-roll is both the expensive option and the strategically weaker one
# for a provenance channel. Real archival footage is free AND more persuasive.
# See docs/04-stack.md.
FAL_KEY=
ATLASCLOUD_API_KEY=
KLING_API_KEY=
RUNWAY_API_KEY=
XAI_API_KEY=
SUNO_API_KEY=
HEYGEN_API_KEY=
OPENAI_API_KEY=
