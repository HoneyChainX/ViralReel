{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HoneyChainX/ViralReel/schemas/evidence.schema.json",
  "title": "Price Archaeology evidence pack",
  "description": "Produced by trend-archaeologist. Audited by compliance-officer. Every price claim in a script must map to a claim in this file.",
  "type": "object",
  "required": ["slug", "object", "segment", "claims", "primary_cause", "artifact", "footage_candidates"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "object": {
      "type": "string",
      "description": "The specific artifact. Must be a concrete object, not a category."
    },
    "segment": {
      "enum": ["THE DIG", "STILL CHEAP", "EXTINCT PRICES", "TIME CAPSULE CART"]
    },
    "spec_note": {
      "type": "string",
      "description": "The tier/spec being compared, so 2016 and 2026 are like-for-like. State the asterisk rather than hiding it."
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "value", "currency", "year", "sources"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "value": { "type": "number" },
          "currency": { "type": "string", "default": "USD" },
          "year": { "type": "integer" },
          "estimated": {
            "type": "boolean",
            "default": false,
            "description": "If true the script must say 'roughly'. Never present an estimate as found."
          },
          "inflation_adjusted_value": { "type": ["number", "null"] },
          "sources": {
            "type": "array",
            "minItems": 2,
            "description": "Two independent sources, at least one primary. Gate check C2.",
            "items": {
              "type": "object",
              "required": ["url", "kind", "accessed"],
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "kind": { "enum": ["primary", "secondary"] },
                "publisher": { "type": "string" },
                "snapshot_date": { "type": "string" },
                "series_id": { "type": "string", "description": "BLS or FRED series ID where applicable" },
                "accessed": { "type": "string", "format": "date" },
                "quote": { "type": "string", "description": "The figure as it literally appears at the source." }
              }
            }
          }
        }
      }
    },
    "primary_cause": {
      "type": "object",
      "required": ["summary", "mechanism", "sources"],
      "description": "Exactly one cause reaches the script. Selecting it is the researcher's job, not the writer's.",
      "properties": {
        "summary": { "type": "string", "maxLength": 200 },
        "mechanism": {
          "enum": ["tariff", "patent-expiry", "supply-chain", "subsidy", "licensing", "manufacturing-scale", "regulation", "demand-shift", "currency"]
        },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "secondary_causes": { "type": "array", "items": { "type": "string" } },
    "artifact": {
      "type": "object",
      "required": ["kind", "path", "description"],
      "description": "The original research artifact. Gate check C1 — must not have existed in retrievable form before this episode.",
      "properties": {
        "kind": { "enum": ["wayback-screenshot", "original-chart", "assembled-comparison", "archival-provenance"] },
        "path": { "type": "string" },
        "description": { "type": "string" },
        "source_url": { "type": "string" }
      }
    },
    "footage_candidates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["url", "license"],
        "properties": {
          "url": { "type": "string" },
          "license": { "type": "string" },
          "note": { "type": "string" },
          "has_motion": { "type": "boolean" }
        }
      }
    },
    "verdict": { "enum": ["RIPOFF", "FAIR", "STILL CHEAP", "EXTINCT"] },
    "affiliate_eligible": {
      "type": "boolean",
      "description": "True only for STILL CHEAP. monetization-lead blocks placement elsewhere."
    }
  }
}
