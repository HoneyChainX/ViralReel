# youtube-automation-agent — distribution.
# Copied to vendor/yt-agent/.env by make setup, then completed by `npm run walkthrough`.
#
# EVERY VARIABLE BELOW WAS VERIFIED TO BE READ BY THE VENDOR CODE. An earlier
# version of this file invented YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET /
# YOUTUBE_REFRESH_TOKEN and PRIVACY_STATUS. The tool reads none of those — see
# "OAuth is NOT configured here" below. Do not add a variable to this file
# without grepping the vendor for it first.

# Free tier. Claude does the creative work upstream; this LLM only drives the
# publish/SEO/analytics loop.
#   read at: index.js:97  -> creds.gemini?.apiKey || process.env.GEMINI_API_KEY
GEMINI_API_KEY=

# Protects the local dashboard's mutating endpoints (:3456). Set it.
#   read at: index.js:133 -> process.env.API_KEY
API_KEY=

# Uploads land private. NOTE THE PREFIX — the variable is DEFAULT_PRIVACY_STATUS,
# not PRIVACY_STATUS. The vendor hardcodes 'private' as its fallback, so a typo
# here fails safe rather than publishing, but it also means a typo is invisible.
#   read at: agents/publishing-scheduling-agent.js:130
#            -> process.env.DEFAULT_PRIVACY_STATUS || 'private'
DEFAULT_PRIVACY_STATUS=private

NODE_ENV=production
PORT=3456
LOG_LEVEL=info

# ── OAuth is NOT configured here ────────────────────────────────────────────
# YouTube OAuth does not use environment variables at all. `npm run walkthrough`
# prompts you to paste the Client ID and Client Secret at the terminal and writes
# them to:
#     vendor/yt-agent/config/credentials.json     (utils/credential-manager.js:11)
# The browser consent flow then writes the tokens to:
#     vendor/yt-agent/config/tokens.json          (modern-auth.js:11)
# Both are gitignored. Nothing you put in this file affects YouTube auth.
