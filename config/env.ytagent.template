# youtube-automation-agent — distribution.
# Copied to vendor/yt-agent/.env by make setup, then completed by `npm run walkthrough`.

# Free tier. Claude does the creative work upstream; this LLM only drives
# the publish/SEO/analytics loop.
GEMINI_API_KEY=

# Protects the local dashboard's mutating endpoints (:3456). Set it.
API_KEY=

# NOT a default we inherited — a decision. Nothing this studio produces goes
# public without a human looking at it. Gate check C10 enforces it.
PRIVACY_STATUS=private

# Set by `npm run walkthrough` (browser OAuth).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
